# Copy to .env (in the repository root) and adjust. Never commit .env.
#
# The defaults below match the project-local PostgreSQL cluster created by
#   powershell -ExecutionPolicy Bypass -File scripts\dev-db.ps1 init
# which listens on localhost:5433 only. They are local-development values,
# not secrets; use real credentials for any shared or deployed database.

# SQLAlchemy URL for the application database (psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://cgq_app:cgq_local_dev@localhost:5433/cgq

# Database used by the backend test suite. Tests drop and recreate its tables.
TEST_DATABASE_URL=postgresql+psycopg://cgq_app:cgq_local_dev@localhost:5433/cgq_test

# Comma-separated browser origins allowed to call the API directly (CORS).
# In development the Vite dev server proxies /api, so this is only needed when
# the frontend is served from a different origin than the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Python logging level for the API.
LOG_LEVEL=INFO
